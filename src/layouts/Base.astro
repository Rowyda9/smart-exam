---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { site, navigation } from '../data/site';
interface Props { title: string; description?: string; lang?: string; noindex?: boolean; }
const { title, description = site.description, lang = 'en', noindex = false } = Astro.props;
const indexable = import.meta.env.SITE_INDEXABLE === 'true' && !noindex;
const canonical = new URL(Astro.url.pathname, site.origin).href;
const schema = { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: site.name, applicationCategory: 'BusinessApplication', operatingSystem: 'Web browser', url: site.origin, description: site.description, featureList: ['Examination management', 'Department-scoped operations', 'Browser-based proctoring', 'Customer-hosted deployment'] };
---
<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Smart Exam</title><meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
    <link rel="canonical" href={canonical} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0a1829" />
    <meta property="og:type" content="website" /><meta property="og:site_name" content="Smart Exam" />
    <meta property="og:title" content={`${title} | Smart Exam`} /><meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} /><meta property="og:image" content={`${site.origin}/social-card.png`} />
    <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} />
    {Astro.url.pathname === '/' && <><link rel="alternate" hreflang="en" href={site.origin + '/'} /><link rel="alternate" hreflang="ar" href={site.origin + '/ar/'} /><link rel="alternate" hreflang="x-default" href={site.origin + '/'} /></>}
    {Astro.url.pathname === '/ar/' && <><link rel="alternate" hreflang="en" href={site.origin + '/'} /><link rel="alternate" hreflang="ar" href={site.origin + '/ar/'} /></>}
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header"><div class="container header-inner"><Logo />
      <button class="mobile-toggle" aria-expanded="false" aria-controls="primary-navigation">Menu <span aria-hidden="true">☰</span></button>
      <nav id="primary-navigation" class="main-nav" aria-label="Primary navigation">
        {navigation.map(item => <a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>{item.label}</a>)}
        <a href="/ar/" lang="ar" class="language-link">العربية</a>
        <a href="/request-demo/" class="button button-small button-dark" data-conversion="nav_demo">Request a demo</a>
      </nav>
    </div></header>
    <main id="main"><slot /></main>
    <footer class="site-footer" dir="ltr"><div class="container"><div class="footer-grid"><div class="footer-brand"><Logo light /><p>Enterprise examination operations.<br />On your infrastructure.</p><a href="/request-demo/" class="footer-contact">Explore your deployment</a></div><div><h2>Platform</h2><a href="/examination-management/">Examination management</a><a href="/departments/">Department operations</a><a href="/live-proctoring/">Live proctoring</a><a href="/recording-evidence/">Recording & evidence</a><a href="/intelligent-monitoring/">Advisory monitoring</a></div><div><h2>Enterprise</h2><a href="/on-premises/">Customer-hosted deployment</a><a href="/security/">Security & data control</a><a href="/integrations/">Integrations</a><a href="/solutions/">Industry solutions</a><a href="/licensing/">Licensing</a></div><div><h2>Connect</h2><a href="/demo/">Product walkthrough</a><a href="/resources/">Resources</a><a href="/partners/">Become a partner</a><a href="/request-quote/">Request a quote</a><a href="/contact/">Contact sales</a><a href="/faq/">FAQ</a></div></div>
      <div class="footer-bottom"><p>© {new Date().getUTCFullYear()} Smart Exam. Product brand.</p><div><a href="/privacy/">Privacy</a><a href="/terms/">Website terms</a><a href="/ar/" lang="ar">العربية</a></div></div>
      <p class="legal-line">Commercial seller and regional contact details are confirmed during engagement. {site.legalEntity}{site.salesEmail && <a href={`mailto:${site.salesEmail}`}>{site.salesEmail}</a>}</p>
    </div></footer>
    <script is:inline src="/scripts/navigation.js" defer></script>
  </body>
</html>
