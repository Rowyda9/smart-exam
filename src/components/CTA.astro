---
const { title = 'Start with your examination workflow.', text = 'Tell us how your examinations run today. Explore the platform, deployment requirements and a practical path to acceptance.', href = '/request-demo/', label = 'Request a demo' } = Astro.props;
---
<section class="cta-section"><div class="container cta-inner"><div><span class="eyebrow">A focused conversation</span><h2>{title}</h2><p>{text}</p></div><a class="button button-dark" href={href} data-conversion="cta_demo">{label}</a></div></section>
