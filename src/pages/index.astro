---
import Base from '../layouts/Base.astro';
import Workspace from '../components/Workspace.astro';
import Architecture from '../components/Architecture.astro';
import CTA from '../components/CTA.astro';
---
<Base title="Enterprise examination operations on your infrastructure">
  <section class="home-hero"><div class="container"><div class="hero-grid"><div class="hero-copy"><span class="eyebrow">Enterprise assessment. Customer controlled.</span><h1>Every exam.<br />Under your <span>control.</span></h1><p>Bring question banks, examination delivery and proctor review into one platform. Give your teams defined responsibilities. Keep deployment decisions with your organization.</p><div class="button-row"><a class="button button-dark" href="/request-demo/" data-conversion="hero_demo">Request a demo</a><a class="button button-outline" href="/platform/">Explore the platform</a></div><p class="hero-note">Department-scoped operations · Customer-hosted deployment</p></div><div class="hero-visual"><Workspace /><p class="visual-footnote">Illustrative workspace with synthetic data. Not a live product capture.</p></div></div><div class="hero-bottom"><span><i class="small-square"></i>Examination management</span><span><i class="small-square"></i>Human-led proctoring</span><span><i class="small-square"></i>English & Arabic workflows</span></div></div></section>
  <section class="principle-strip" aria-label="Platform principles"><div class="container principles"><span>Built around the way enterprise examinations operate.</span><strong>Defined responsibilities</strong><strong>Reviewable evidence</strong><strong>Infrastructure choice</strong></div></section>
  <section class="section-space"><div class="container"><div class="section-intro"><div><span class="eyebrow">One connected operation</span><h2>Bring structure to every stage of assessment.</h2></div><p>From the first question to the published result, give each team a clear part in the process.</p></div><div class="platform-grid"><div class="feature-list"><article class="feature-item"><span class="feature-icon" aria-hidden="true">▤</span><div><h3>Prepare and deliver with confidence</h3><p>Reuse question banks, organize candidate cohorts and choose fixed starts or flexible examination windows.</p><a href="/examination-management/" class="text-link">Explore examination management</a></div></article><article class="feature-item"><span class="feature-icon" aria-hidden="true">◇</span><div><h3>Give departments a defined scope</h3><p>Set operational boundaries for examination teams, with role-based access and central oversight.</p><a href="/departments/" class="text-link">Understand department operations</a></div></article><article class="feature-item"><span class="feature-icon" aria-hidden="true">◷</span><div><h3>Keep people behind the decisions</h3><p>Support proctors and reviewers with live context, captured webcam evidence and session events.</p><a href="/recording-evidence/" class="text-link">See the review workflow</a></div></article></div><div class="control-panel"><span class="eyebrow">Department governance</span><h3>Local responsibilities.<br />Central oversight.</h3><div class="dept-stack"><div class="dept-stack-header"><strong>Your organization</strong><span>Central admin</span></div><div class="dept-stack-row"><span class="dept-icon blue">L</span>Learning & development<span class="scope-label">Scoped</span></div><div class="dept-stack-row"><span class="dept-icon lime">T</span>Technical training<span class="scope-label">Scoped</span></div><div class="dept-stack-row"><span class="dept-icon lavender">C</span>Compliance programs<span class="scope-label">Scoped</span></div></div><p>Illustrative organization. Departments use logical access controls in a shared application and database.</p></div></div></div></section>
  <section class="deployment-section"><div class="container deployment-grid"><div><span class="eyebrow">Your infrastructure, considered</span><h2>Put your operating requirements at the center.</h2><p>Plan application, database and evidence storage within your approved environment. Define identity, external services and support responsibilities before rollout.</p><a href="/on-premises/" class="text-link">Explore customer-hosted deployment</a></div><Architecture /></div></section>
  <section class="section-space"><div class="container"><div class="section-intro"><div><span class="eyebrow">Proctoring with context</span><h2>A clearer view.<br />A considered decision.</h2></div><p>Support examination integrity with a human-led process, clear review responsibilities and agreed evidence handling.</p></div><div class="pillars"><article class="pillar"><span class="feature-icon" aria-hidden="true">◉</span><h3>Observe live sessions</h3><p>Browser webcam video and optional live screen sharing give authorized proctors session context.</p><a href="/live-proctoring/" class="text-link">Live proctoring</a></article><article class="pillar"><span class="feature-icon" aria-hidden="true">▥</span><h3>Review captured evidence</h3><p>Inspect webcam recordings, snapshots and events when configured. Plan retention and reviewer access.</p><a href="/recording-evidence/" class="text-link">Recording & evidence</a></article><article class="pillar"><span class="feature-icon" aria-hidden="true">⌁</span><h3>Interpret advisory signals</h3><p>Use browser and camera-condition events to guide human review. A signal alone does not establish misconduct.</p><a href="/intelligent-monitoring/" class="text-link">Advisory monitoring</a></article></div></div></section>
  <section class="section-space soft-bg"><div class="container"><div class="section-intro"><div><span class="eyebrow">Designed around your program</span><h2>Different organizations.<br />A shared need for control.</h2></div><a class="text-link" href="/solutions/">Explore industry solutions</a></div><div class="solutions-grid"><article class="solution-card"><div class="solution-art"><span>PROFESSIONAL LEARNING</span></div><div class="solution-body"><h3>Training providers</h3><p>Coordinate owned assessments across programs, cohorts and locations.</p><a href="/solutions/#training" class="text-link">Training operations</a></div></article><article class="solution-card"><div class="solution-art"><span>PROFESSIONAL STANDARDS</span></div><div class="solution-body"><h3>Certification teams</h3><p>Plan examination delivery, reviewer responsibilities and candidate evidence.</p><a href="/solutions/#certification" class="text-link">Certification examinations</a></div></article><article class="solution-card"><div class="solution-art"><span>WORKFORCE DEVELOPMENT</span></div><div class="solution-body"><h3>Corporate academies</h3><p>Bring department qualification programs into a consistent operating workflow.</p><a href="/solutions/#corporate" class="text-link">Corporate assessment</a></div></article></div></div></section>
  <section class="section-space"><div class="container"><div class="section-intro"><div><span class="eyebrow">Make an informed decision</span><h2>Start with the right questions.</h2></div><p>Useful planning material for your assessment, IT and governance teams.</p></div><article class="resource-row"><div><span class="resource-kicker">Deployment guide</span><h3>Planning a customer-hosted examination platform</h3><p>Infrastructure, identity, storage and the operating questions to agree before rollout.</p></div><div><a href="/resources/deployment-checklist/" class="text-link">Read the checklist</a></div></article><article class="resource-row"><div><span class="resource-kicker">Platform brochure</span><h3>Smart Exam at a glance</h3><p>A concise overview to share with your assessment and technology teams.</p></div><div><a href="/downloads/smart-exam-brochure.pdf" class="text-link" data-conversion="brochure_download">Download brochure (PDF)</a></div></article></div></section>
  <CTA />
</Base>
