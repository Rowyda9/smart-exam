---
import Base from '../layouts/Base.astro'; import Workspace from '../components/Workspace.astro'; import CTA from '../components/CTA.astro';
const stages = [
 {id:'operations',label:'Prepare & deliver',title:'Give the examination a clear structure.',text:'Organize question content, prepare candidate cohorts and set a fixed start or flexible window. This synthetic example shows three programs in an illustrative organization.'},
 {id:'departments',label:'Define responsibilities',title:'Put department scope into the workflow.',text:'Department-aware access supports defined examination responsibilities, with central oversight. Departments share the application and database; user and role administration remains central.'},
 {id:'evidence',label:'Review evidence',title:'Keep the decision with a human reviewer.',text:'Use captured webcam evidence and session events to understand what happened. Advisory signals need context. Recording coverage depends on the accepted deployment and network conditions.'},
];
---
<Base title="Illustrative product walkthrough" description="Explore a synthetic Smart Exam workflow for examination operations, department responsibilities and human evidence review."><section class="page-hero"><div class="container page-title-only"><span class="eyebrow">Interactive platform story</span><h1>Explore the operating workflow.</h1><p class="intro">Walk through preparation, departmental responsibility and evidence review. Then bring your own requirements to a tailored demonstration.</p></div></section><section class="walkthrough"><div class="container"><div class="demo-controls" role="tablist" aria-label="Examination workflow stages">{stages.map((s,i)=><button role="tab" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-stage={s.id}>{s.label}</button>)}</div>{stages.map((s,i)=><div class="demo-panel" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} tabindex="0" hidden={i!==0}><div><span class="eyebrow">{s.label}</span><h2>{s.title}</h2><p>{s.text}</p><a href="/request-demo/" class="text-link" style="margin-top:25px">Discuss a relevant scenario</a></div><Workspace variant={s.id} /></div>)}<p class="demo-disclosure">This is an explanatory interface built with synthetic data. It is not the operational product, a live customer environment or a verified product screenshot. No camera, candidate records or examination service is connected.</p></div></section><CTA title="Now make it relevant to your organization." /></Base>
<script is:inline src="/scripts/walkthrough.js" defer></script>
