---
import Base from '../layouts/Base.astro'; import CTA from '../components/CTA.astro';
const solutions = [
  { id:'training', name:'Training providers', title:'Give every program a repeatable examination process.', body:'Coordinate owned assessments across courses, cohorts and departments. Reuse content, prepare candidates and publish reviewed results with a clear operating process.', items:['Reusable question banks and cohort administration','Fixed starts and flexible examination windows','Bilingual delivery and approved walk-in workflows'], scope:'External awarding-body examinations require the awarding body’s permission and acceptance. Start with assessments you own.' },
  { id:'certification', name:'Certification teams', title:'Build a controlled examination delivery workflow.', body:'Bring exam setup, candidate access, proctoring and evidence review into one operational discussion. Define the responsibilities of examiners, administrators and reviewers.', items:['Structured examination preparation','Human supervision and evidence review','Role and assignment-based workflows'], scope:'Credential issuance, accreditation, psychometrics, accommodations and standards requirements are assessed separately. Smart Exam is not presented as a complete credential lifecycle system.' },
  { id:'corporate', name:'Corporate academies', title:'Coordinate qualification across departments.', body:'Support internal knowledge and professional qualification programs with department-scoped examination operations in customer-controlled infrastructure.', items:['Department scope with central oversight','Candidate batches and repeatable exam settings','Deployment and identity integration discovery'], scope:'LMS, HR and identity connections require technical scoping. Training content, skill validity and organizational policy remain customer responsibilities.' },
];
---
<Base title="Assessment solutions for training, certification and corporate academies" description="Explore Smart Exam workflows for owned professional training assessments, certification examination delivery and corporate qualification programs."><section class="page-hero"><div class="container page-title-only"><span class="eyebrow">Industry solutions</span><h1>Build around the examination you need to run.</h1><p class="intro">Start with your assessment process, the teams involved and the control your organization requires.</p><div class="related-links">{solutions.map(s=><a href={`#${s.id}`}>{s.name}</a>)}</div></div></section><section class="section-space"><div class="container detail-grid"><nav class="detail-nav" aria-label="Industry solutions"><strong>Explore your use case</strong>{solutions.map(s=><a href={`#${s.id}`}>{s.name}</a>)}</nav><div>{solutions.map(s=><article class="detail-section" id={s.id}><span class="eyebrow">{s.name}</span><h2>{s.title}</h2><p>{s.body}</p><ul class="check-list">{s.items.map(i=><li>{i}</li>)}</ul><p style="font-size:.82rem;margin-top:25px">{s.scope}</p><a href="/request-demo/" class="text-link" style="margin-top:25px">Discuss this workflow</a></article>)}</div></div></section><CTA /></Base>
