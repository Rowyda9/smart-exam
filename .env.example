# Local preview stays noindex. Production publication requires separate approval.
HOST=127.0.0.1
PORT=4321
SITE_URL=http://127.0.0.1:4321
SITE_INDEXABLE=false

# Form processing is intentionally disabled until a real legal seller/privacy
# notice, CRM destination, mail delivery and ownership are approved.
LEAD_FORMS_ENABLED=false
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=
FORM_SECRET=
PRIVACY_NOTICE_APPROVED=false
LEGAL_ENTITY_APPROVED=false

# Optional public contact fields: see src/data/site.ts and rebuild.
# Never put credentials into PUBLIC_ variables or src/data/site.ts.
# Native events contain no PII. No third-party tracking is loaded.
ANALYTICS_ENABLED=false

# In production put this service behind HTTPS and a managed reverse proxy.
# Keep HOST loopback unless an administrator explicitly approves network access.
